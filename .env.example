# Required. Get a key at https://console.groq.com
GROQ_API_KEY=
# Optional backup keys. The chat API tries the next key when Groq returns
# a rate-limit/capacity error.
GROQ_API_KEY_2=
# Optional fallback provider used after every Groq model/key is exhausted.
OPENROUTER_API_KEY=

# Production URL used for canonical/OG metadata and the sitemap.
APP_URL=https://edwinantonie.vercel.app
# Sent as HTTP-Referer to OpenRouter (defaults to http://localhost:3000).
NEXT_PUBLIC_APP_URL=https://edwinantonie.vercel.app

# Required. Get your free key at resend.com (3000 emails/month free)
RESEND_API_KEY=
# Sender on a domain verified in Resend. The default sandbox sender
# (onboarding@resend.dev) can only deliver to your own Resend account email,
# so visitor auto-replies fail until this is set.
RESEND_FROM_EMAIL=
